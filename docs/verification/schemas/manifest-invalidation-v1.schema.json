{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemeath.dev/schemas/verification/manifest-invalidation-v1.schema.json",
  "title": "Aemeath immutable manifest invalidation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordType", "recordId", "invalidatedManifestId",
    "frozenArtifactPath", "frozenArtifactSha256", "replacementManifestId",
    "invalidatedAt", "reason", "reviewer"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "manifest-invalidation" },
    "recordId": { "type": "string", "pattern": "^[A-Z0-9.]+-v[0-9]+-invalidated-by-v[0-9]+$" },
    "invalidatedManifestId": { "type": "string", "pattern": "^[A-Z0-9.]+-v[0-9]+$" },
    "frozenArtifactPath": { "type": "string", "pattern": "^docs/verification/manifests/[A-Z0-9.]+-v[0-9]+\\.yml$" },
    "frozenArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "replacementManifestId": { "type": "string", "pattern": "^[A-Z0-9.]+-v[0-9]+$" },
    "invalidatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reason": { "type": "string", "minLength": 20 },
    "reviewer": { "type": "string", "minLength": 3 }
  }
}
