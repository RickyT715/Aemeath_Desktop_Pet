{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemeath.dev/schemas/verification/hosted-windows-capabilities-v1.schema.json",
  "title": "Aemeath hosted Windows capability evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "documentType", "sourceSha", "runnerOs", "runnerArch", "imageOs",
    "osVersion", "processSessionId", "userInteractive", "uiaAssembliesLoaded",
    "primaryDisplayWidth", "primaryDisplayHeight", "displayProbeAvailable", "dpiProbeAvailable",
    "systemDpiX", "systemDpiY", "systemScalePercent", "narratorObserved",
    "minimumFreeBytes", "actualFreeBytesAtProbe", "isolatedStorageRoundTrip",
    "cleanupVerified", "githubNetworkAllowed", "timeoutEnforced", "personalDataCollected",
    "secretValuesCollected"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "hosted-windows-capabilities" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runnerOs": { "const": "Windows" },
    "runnerArch": { "const": "X64" },
    "imageOs": { "type": "string", "minLength": 1 },
    "osVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "processSessionId": { "type": "integer", "minimum": 0 },
    "userInteractive": { "type": "boolean" },
    "uiaAssembliesLoaded": { "const": true },
    "primaryDisplayWidth": { "type": "integer", "minimum": 0 },
    "primaryDisplayHeight": { "type": "integer", "minimum": 0 },
    "displayProbeAvailable": { "type": "boolean" },
    "dpiProbeAvailable": { "type": "boolean" },
    "systemDpiX": { "type": "integer", "minimum": 0 },
    "systemDpiY": { "type": "integer", "minimum": 0 },
    "systemScalePercent": { "type": "integer", "minimum": 0 },
    "narratorObserved": { "type": "boolean" },
    "minimumFreeBytes": { "type": "integer", "minimum": 5368709120 },
    "actualFreeBytesAtProbe": { "type": "integer", "minimum": 5368709120 },
    "isolatedStorageRoundTrip": { "const": true },
    "cleanupVerified": { "const": true },
    "githubNetworkAllowed": { "const": true },
    "timeoutEnforced": { "const": true },
    "personalDataCollected": { "const": false },
    "secretValuesCollected": { "const": false }
  }
}
