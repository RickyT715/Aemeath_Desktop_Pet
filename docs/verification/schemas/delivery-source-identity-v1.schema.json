{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemeath.dev/schemas/verification/delivery-source-identity-v1.schema.json",
  "title": "Aemeath delivery source identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedSha", "actualSha", "event", "runId", "runAttempt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expectedSha": { "$ref": "#/$defs/sha1" },
    "actualSha": { "$ref": "#/$defs/sha1" },
    "event": { "const": "push" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
